# ── Core (all optional — app degrades gracefully) ──────────────────────────
# GitHub enrichment (5000 req/hr vs 60 unauthenticated)
GITHUB_TOKEN=

# LLM providers (open-weight by default; optional closed-weight providers (OpenAI, Ultramarine) are opt-in and labelled)
# Gemma via AI Studio OpenAI-compat endpoint — autopsy, seance, arena, judge, lifecycle
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
# Task → provider mapping (gemma-aistudio | gemma-do | tinker-epitaph | backboard:<model> | ollama | openai[:<model>] | ultramarine)
# Supports comma-separated fallback chains, e.g. LLM_AUTOPSY_PROVIDER=gemma-aistudio,openai
LLM_AUTOPSY_PROVIDER=gemma-aistudio
LLM_EPITAPH_PROVIDER=tinker-epitaph
LLM_SEANCE_PROVIDER=gemma-aistudio
LLM_ARENA_PROVIDERS=gemma-aistudio,backboard:qwen3-8b,backboard:llama-3.3-70b

# OpenAI — OPTIONAL closed-weight provider. Never on the default path; opt in per task.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
# Part A lifecycle classifier (second opinion on ambiguous README text)
LLM_LIFECYCLE_PROVIDER=gemma-aistudio
# Mastra agents: gemma (default) | openai
MASTRA_MODEL_PROVIDER=

# Tinker fine-tuned epitaph LoRA (served through the ml service /tinker route)
TINKER_API_KEY=
TINKER_BASE_MODEL=Qwen/Qwen3-8B

# DigitalOcean Gradient serverless inference (provider: gemma-do)
DO_MODEL_URL=
DO_MODEL_TOKEN=
DO_MODEL_NAME=

# Backboard — one key powers /arena across open-weight models
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://api.backboard.io/v1

# Ultramarine — CLOSED BASELINE ONLY (comparisons, never product path)
ULTRAMARINE_API_KEY=
ULTRAMARINE_BASE_URL=
ULTRAMARINE_MODEL=

# Offline path — local Ollama (ollama pull gemma3:4b)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b
REVENANT_OFFLINE=

# ── Data stores (file-based fallbacks work without these) ──────────────────
MONGODB_URI=
DATABASE_URL=            # Tiger Cloud Postgres w/ pgvector
TIGER_DATABASE_URL=
REVENANT_DATA_DIR=

# ── ML service ──────────────────────────────────────────────────────────────
ML_SERVICE_URL=
TABPFN_MODE=api          # api | local | off
PRIORLABS_API_KEY=
EMB_MODEL=google/embeddinggemma-300m

# ── Durable execution ───────────────────────────────────────────────────────
TEMPORAL_ADDRESS=        # e.g. xxx.tmprl.cloud:7233 — unset ⇒ in-process pipeline
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# ── Partner extras ──────────────────────────────────────────────────────────
SERPAPI_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
ELEVENLABS_API_KEY=

# Auth0 for AI Agents (sign-in, Token Vault, approval-gated PRs)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Public URLs (metadataBase / social cards)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
RENDER_EXTERNAL_URL=
RENDER=
RENDER_SERVICE_NAME=
